{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vadobene",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "VB_IMAGE_PROCESSOR": "cloudflare",
    "LAUNCH_ENABLED": "false",
    "SCHEDULER_ENABLED": "false",
    "SCHEDULER_CONFIRMED": "false",
    "BETA_ENABLED": "false",
    "BETA_READY_CONFIRMED": "false",
    "BETA_AUTH_ENABLED": "false",
    "NEXT_PUBLIC_SUPABASE_URL": "https://vzcbylzozovvvzgeacrt.supabase.co",
    "NEXT_PUBLIC_SITE_URL": "https://vadobene.casabearpisa.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "pnpm cf:build"
  },
  "previews": {
    "vars": {
      "VB_IMAGE_PROCESSOR": "cloudflare",
      "LAUNCH_ENABLED": "false",
      "SCHEDULER_ENABLED": "false",
      "SCHEDULER_CONFIRMED": "false",
      "VB_PREVIEW_LOCKED": "true",
      "BETA_ENABLED": "false",
      "BETA_READY_CONFIRMED": "false",
      "BETA_AUTH_ENABLED": "false"
    },
    "images": {
      "binding": "IMAGES"
    }
  },
  "preview_urls": true
}

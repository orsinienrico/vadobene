# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # solo server, mai in client
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Anthropic ─────────────────────────────────────────────
# Vive solo in route handler server-side (CLAUDE.md). Mai NEXT_PUBLIC_.
ANTHROPIC_API_KEY=<anthropic-key>

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=<sk-...>
STRIPE_WEBHOOK_SECRET=<whsec-...>
# Non usata dal codice (checkout via redirect server-side):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk-...>
# Price ID creati su Stripe Dashboard:
STRIPE_PRICE_BOOST=<price_...>            # Boost €0,99 una tantum
STRIPE_PRICE_PRO_MONTHLY=<price_...>      # Pro €3,99/mese
STRIPE_PRICE_PRO_YEARLY=<price_...>       # Pro €29/anno

# ── Resend ────────────────────────────────────────────────
RESEND_API_KEY=<re-...>
RESEND_FROM="vado bene? <ciao@vadobene.app>"

# ── PostHog ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=<phc-...>
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Sito ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://vadobene.app

# ── Cron (Vercel Cron → /api/cron/*) ──────────────────────
CRON_SECRET=<random-string>

# ── Giurì ─────────────────────────────────────────────────
# Durata del timer del giurì in secondi (default 180 = 3 minuti).
# In test si può accelerare, es.: JURY_DURATION_SECONDS=10
# JURY_DURATION_SECONDS=180
